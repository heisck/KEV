# ─────────────────────────────────────────────────────────────
# KEV — SINGLE root environment file (placeholders only — NEVER commit real values)
# Copy this to `.env` at the repo root; all three services read it directly:
#   frontend (app.config.ts) · backend (run-backend.mjs) · ml (run-ml.mjs)
# A service-local .env (frontend/.env, backend/.env, ml/.env) still overrides
# these if present, but is optional. In CI/prod values come from
# GitHub Actions secrets / EAS secrets / host env.
# ─────────────────────────────────────────────────────────────

# ===== Frontend (Expo) — only EXPO_PUBLIC_* are bundled into the app =====
# localhost only works for a simulator on the same machine. Phones / a second
# lecturer's device must use the LAN IP of the host running the backend, e.g.
# http://192.168.1.20:8080 — and that origin must be in APP_CORS_ALLOWED_ORIGINS.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_SENTRY_DSN=your-frontend-sentry-dsn-here
# Google OAuth client IDs (from Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id-here.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id-here.apps.googleusercontent.com
# Used only by EAS / Sentry CLI at build time (NOT bundled):
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-sentry-org-here
SENTRY_PROJECT_FRONTEND=kev-frontend
# EAS build project id (from `eas init`); only needed for cloud builds.
EAS_PROJECT_ID=

# ===== Backend (Spring Boot) =====
# Neon serverless Postgres — ALL lecturers must point at the SAME database, or each
# device sees only its own sessions. Copy "Pooled connection" from the Neon console
# (host must contain -pooler); direct hosts sleep → Connection refused under load.
# Paste the Neon string verbatim — scripts/load-root-env.mjs splits out user/password:
#   SPRING_DATASOURCE_URL=postgresql://user:pass@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# The explicit JDBC form works too (then fill in the two vars below):
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your-neon-user-here
SPRING_DATASOURCE_PASSWORD=your-neon-password-here
# Upstash Redis (TLS) — host/port/password from the Upstash console.
# HOST is a bare hostname: copy it from the redis:// connection string, NOT the REST URL.
# A "https://..." value here fails DNS resolution on every cached lookup.
# PASSWORD is the token in `redis://default:<PASSWORD>@<host>:6379`.
UPSTASH_REDIS_HOST=your-upstash-host-here.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-upstash-password-here
UPSTASH_REDIS_SSL=true
# No Redis to hand? Set CACHE_TYPE=none and leave the Upstash vars blank.
CACHE_TYPE=redis
# Auth — JWT signing secret (>= 32 bytes) and accepted Google client IDs (comma-separated)
JWT_SECRET=changeme-generate-a-long-random-secret-min-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_IDS=your-web-client-id-here.apps.googleusercontent.com,your-ios-client-id-here.apps.googleusercontent.com
# Sign in with Apple — comma-separated bundle/service IDs. Blank disables Apple sign-in.
APPLE_CLIENT_IDS=
# First administrator — the ONLY account not provisioned in-app. Created on first boot
# if the email is not already present; an existing account is never re-hashed, so
# changing this later does not reset a password changed in the app. Password must be
# >= 12 chars (the app refuses to start otherwise). Leave blank once the admin exists.
KEV_ADMIN_EMAIL=your-admin-address-here@example.com
KEV_ADMIN_PASSWORD=generate-a-long-random-password-min-12-chars
KEV_ADMIN_NAME=KEV Administrator
# SMS — Arkesel (Ghana). Blank API key keeps SMS log-only, same as email.
# Sender ID must be pre-registered with Arkesel or sends are rejected.
ARKESEL_API_KEY=your-arkesel-api-key-here
ARKESEL_SENDER_ID=KEV-EXAM
# Email — Gmail REST API over HTTPS, NOT SMTP. Render blocks outbound 25/465/587 on
# free web services and Railway blocks them below Pro, so SMTP silently times out there.
# Mint the refresh token once with: node scripts/gmail-refresh-token.mjs
# Leave GMAIL_REFRESH_TOKEN blank to keep email log-only (local dev / CI).
GMAIL_CLIENT_ID=your-gmail-oauth-client-id-here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret-here
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=your-sending-address-here@gmail.com
GMAIL_FROM_NAME=KEV Exam Verification
# Observability
SENTRY_DSN_BACKEND=your-backend-sentry-dsn-here
# CORS — comma-separated allowed origins for the app/web
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# University directory provider (mock = seeded UITS simulation) and ML service URL
KEV_DIRECTORY_PROVIDER=mock
ML_BASE_URL=http://localhost:8000
# External UITS student system — roster is pulled from here when a session is created.
UITS_BASE_URL=https://kev-uits-rep.vercel.app

# ===== ML service (FastAPI) =====
HF_TOKEN=your-hugging-face-token-here
HF_FACE_MODEL_ID=your-org/your-face-model-here
ML_SENTRY_DSN=your-ml-sentry-dsn-here
ML_PORT=8000
# Face verification (InsightFace buffalo_sc; model auto-downloads on first use)
FACE_MODEL_NAME=buffalo_sc
FACE_MATCH_THRESHOLD=0.35
